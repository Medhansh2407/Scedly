# Copy this file to .env and fill in real values.
# Never commit .env to git.

# ---------- Database ----------
# Local Postgres example:
DATABASE_URL=postgresql://postgres:password@localhost:5432/calendar

# Local SQLite (handy for first run, no Postgres setup needed):
# DATABASE_URL=sqlite:///./calendar.db

# Supabase (transaction pooler — what you'll use):
# DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-1-[REGION].pooler.supabase.com:5432/postgres


# ---------- Supabase Auth ----------
# Project URL: Supabase Dashboard -> Project Settings -> API -> "Project URL"
SUPABASE_URL=https://your-project-ref.supabase.co

# anon (public) key: Project Settings -> API -> "Project API keys" -> "anon public"
# Used by the frontend, NOT secret on its own.
SUPABASE_ANON_KEY=your_anon_key_here

# service_role key: Project Settings -> API -> "Project API keys" -> "service_role"
# SECRET. Backend admin operations only. Never expose to the frontend.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# JWT Secret: Project Settings -> API -> "JWT Secret"
# SECRET. The backend uses this to verify tokens issued by Supabase Auth.
SUPABASE_JWT_SECRET=your_jwt_secret_here

# Signs short-lived Google/Microsoft OAuth state values to prevent account
# linking attacks. Generate an independent random secret for production.
# If omitted, the backend falls back to SUPABASE_JWT_SECRET.
OAUTH_STATE_SECRET=replace_with_a_long_random_value


# ---------- LLM ----------
# Primary provider: Groq (free tier, fast). Used for all structured-output and
# conversational calls by default. Get a key from console.groq.com.
GROQ_API_KEY=your_groq_key_here

# Fallback provider: Google Gemini. Used when Groq rate-limits or 5xx errors.
# Get a key from aistudio.google.com.
GOOGLE_API_KEY=your_gemini_key_here

# Model tiers (Requirement 10). Both are swappable at deploy time.
MODEL_PARSER=llama-3.1-8b-instant         # cheap + fast structured extraction
MODEL_CHAT=llama-3.3-70b-versatile        # smart conversational replies
MODEL_FALLBACK=gemini-2.0-flash           # used when Groq fails

# Legacy single-provider knobs (kept for backwards compatibility — not used by
# the new llm_client; you can remove these once nothing else references them):
LLM_PROVIDER=groq
GROQ_MODEL=llama-3.3-70b-versatile

# OpenAI (alternative, not currently wired up):
# OPENAI_API_KEY=your_openai_key_here
# OPENAI_MODEL=gpt-4o-mini


# ---------- mem0 ----------
# Get a key from app.mem0.ai
MEM0_API_KEY=your_mem0_key_here

# ---------- Embeddings (Hugging Face Inference API) ----------
# Free tier: 30k requests/month. Get a token from huggingface.co/settings/tokens
HF_API_TOKEN=your_hf_token_here

# ---------- Telegram Bot ----------
# Create via @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# Sent by Telegram in X-Telegram-Bot-Api-Secret-Token. Use the same value
# when registering the webhook with setWebhook(secret_token=...).
TELEGRAM_WEBHOOK_SECRET=replace_with_a_random_value

# ---------- Google Calendar Sync ----------
# Create OAuth credentials at console.cloud.google.com (Calendar API)
GOOGLE_CALENDAR_CLIENT_ID=your_google_calendar_client_id
GOOGLE_CALENDAR_CLIENT_SECRET=your_google_calendar_client_secret
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:8000/calendar-sync/google/callback

# ---------- Microsoft Calendar Sync (Outlook) ----------
# Register app at portal.azure.com → App registrations → Calendar.ReadWrite
MICROSOFT_CLIENT_ID=your_microsoft_client_id
MICROSOFT_CLIENT_SECRET=your_microsoft_client_secret
MICROSOFT_CALENDAR_REDIRECT_URI=http://localhost:8000/calendar-sync/microsoft/callback

# ---------- Slack Bot ----------
# Create at api.slack.com/apps → OAuth & Permissions → Bot Token Scopes:
# chat:write, app_mentions:read, im:history, im:read, im:write, commands
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
SLACK_SIGNING_SECRET=your-slack-signing-secret
SLACK_APP_TOKEN=xapp-your-slack-app-token

# ---------- Gmail / Email Integration ----------
# Option A: Gmail API (OAuth2) — for sending + receiving
GMAIL_CLIENT_ID=your_gmail_client_id
GMAIL_CLIENT_SECRET=your_gmail_client_secret
GMAIL_REDIRECT_URI=http://localhost:8000/email/gmail/callback

# Option B: SMTP fallback (send-only, simpler)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=your_email@gmail.com
# SMTP_PASSWORD=your_app_password
# SMTP_FROM_NAME=YourAppName

# ---------- Multi-channel ----------
# Base URL for internal API calls (used by Telegram bot and MCP server)
SCHEDULER_BASE_URL=http://localhost:8000

# ---------- Billing (Stripe) ----------
# Plan model: 14-day Pro trial (owned by our own trial_ends_at, NO card upfront,
# expires to Free with no auto-charge). Stripe is only used on active upgrade.
#
# Leave these blank to run WITHOUT billing — /billing/* money endpoints return
# 503 and the rest of the API works normally. Fill in to enable.
#
# 1) Secret key:  Stripe Dashboard -> Developers -> API keys (use sk_test_ first)
STRIPE_SECRET_KEY=
# 2) Webhook signing secret:  `stripe listen --forward-to localhost:8000/billing/webhook`
#    (test) or Dashboard -> Developers -> Webhooks (live). Starts with whsec_
STRIPE_WEBHOOK_SECRET=
# 3) Price IDs:  Dashboard -> Product catalog. Create one product "Scedly Pro"
#    with a $9/mo recurring price and a $96/yr recurring price.
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=
# 4) Where Stripe Checkout / Portal sends the user back (your frontend URLs):
STRIPE_SUCCESS_URL=http://localhost:3000/settings?billing=success
STRIPE_CANCEL_URL=http://localhost:3000/settings?billing=cancelled
